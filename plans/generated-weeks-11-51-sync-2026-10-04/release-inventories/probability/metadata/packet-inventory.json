  "topics": [
    {
      "week": 42,
      "slug": "fair-results-lopsided-bag",
      "title": "Fair results from a bag",
      "idea": "An ordered pair of biased draws can produce a fair choice; exact outcome pairing explains why.",
      "gates": "K-1: order, color matching and adult reading. Grades 2-3: row-column grids and small counts. Grades 4-5: compare equal-size outcome sets and track changed assumptions; fractions are optional.",
      "materials": "Opaque bags, equal-size and equal-feel red/blue counters, two-position mats and pencils. Mark counter identities for exact counting; use letters as well as color.",
      "pretest": "Rehearse returning and mixing after every draw. Deliberately chosen stories show possibilities, not random frequencies. No fixed number of draws guarantees an output.",
