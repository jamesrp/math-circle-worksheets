  "topics": [
    {
      "week": 47,
      "slug": "gentle-step-landscapes",
      "title": "Gentle step landscapes",
      "idea": "A neighbor-height rule turns distant clues into feasibility bounds and simultaneous lowest and highest landscapes.",
      "gates": "K-1: compare small whole heights with adult reading. Grades 2-3: count steps and add or subtract distances. Grades 4-5: combine bounds and explain why consistent clues can be filled; formulas may remain adult shorthand.",
      "materials": "Pencils, movable flat markers and visually distinct fixed clues. Main boards use 22 mm site spacing and 20 mm level spacing. Keep zero visible; the drawing's top edge is not an extra height restriction.",
      "pretest": "Actual marker fit and handling remain untested. Check printed spacing and that children preserve fixed clues while changing only one allowed marker.",
