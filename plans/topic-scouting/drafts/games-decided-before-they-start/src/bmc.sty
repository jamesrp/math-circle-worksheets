\newcommand{\brusselsrules}{%
  \begin{tikzpicture}[mm]
    \useasboundingbox (-8.5,-9.5) rectangle (177.5,16.5);
    % join two free arms of different crosses
    \draw[rulebox] (-8,-9) rectangle (83,16);
    \cross[5]{(0,0)} \cross[5]{(24,0)}
    \arrowr{(33,0)}
    \begin{scope}[shift={(50,0)}]
      \cross[5]{(0,0)} \cross[5]{(26,0)}
      \draw[play] (5,0) .. controls (8,9) and (18,9) .. (21,0);
      \draw[line width=1.3pt] (13,2.25) -- (13,11.25);
    \end{scope}
    % join two free arms of the same cross
    \begin{scope}[shift={(95,0)}]
      \draw[rulebox] (-9,-9) rectangle (49,16);
      \cross[5]{(0,0)}
      \arrowr{(9,0)}
      \begin{scope}[shift={(30,0)}]
        \cross[5]{(0,0)}
        \draw[play] (0,5) .. controls (0,22) and (22,0) .. (5,0);
        \draw[line width=1.3pt] (5.7,5.7) -- (12.1,12.1);
      \end{scope}
    \end{scope}
    % no crossing: lines join arm tips and cross each other
    \begin{scope}[shift={(153,0)}]
      \draw[rulebox] (-8,-9) rectangle (24,16);
      \cross[3]{(0,-5)} \cross[3]{(16,5)} \cross[3]{(0,5)} \cross[3]{(16,-5)}
      \draw[play] (3,-5) -- (13,5); \draw[play] (3,5) -- (13,-5);
      \nomark{(19.5,11.5)}
    \end{scope}
  \end{tikzpicture}}

