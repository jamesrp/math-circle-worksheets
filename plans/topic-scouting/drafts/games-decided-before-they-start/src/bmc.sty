% \board{width}{height}{layout}
\newcommand{\board}[3]{%
  \begin{tikzpicture}[mm]
    \draw[black!45,line width=0.6pt,rounded corners=3mm] (-#1/2,-#2/2) rectangle (#1/2,#2/2);
    \foreach \p in #3 {\fill \p circle (1.7);}
  \end{tikzpicture}}
% \crossboard{width}{height}{layout}
\newcommand{\crossboard}[3]{%
  \begin{tikzpicture}[mm]
    \draw[black!45,line width=0.6pt,rounded corners=3mm] (-#1/2,-#2/2) rectangle (#1/2,#2/2);
    \foreach \p in #3 {\cross[11]{\p}}
  \end{tikzpicture}}

% board with a record line underneath
\newcommand{\recboard}[2]{% #1 board, #2 record
  \begin{tabular}{@{}c@{}}#1\\[1.5mm] #2\end{tabular}}

% ---------- rule pictures ----------
% "not allowed" sign: a circle with a slash (not an X, which looks like a cross)
\newcommand{\nomark}[1]{% centre
  \draw[line width=1.2pt] #1 circle (2.5);
  \draw[line width=1.2pt] ($#1+(-1.77,1.77)$) -- ($#1+(1.77,-1.77)$);}
\newcommand{\arrowr}[1]{\draw[-{Stealth[length=2.6mm]},line width=1pt] #1 -- ++(7,0);}

\tikzset{rulebox/.style={draw=black!35,line width=0.5pt,rounded corners=2mm}}
\newcommand{\sprigsrules}{%
  \begin{tikzpicture}[mm]
    \useasboundingbox (-5.5,-10.5) rectangle (169.5,13.5);
    % a line between two dots: each end uses one token
    \draw[rulebox] (-5,-10) rectangle (46,13);
    \fill (0,0) circle (1.7); \fill (12,0) circle (1.7);
    \node[token] at (-2.2,-5.5) {}; \node[token] at (2.2,-5.5) {};
    \node[token] at (9.8,-5.5) {}; \node[token] at (14.2,-5.5) {};
    \arrowr{(17,0)}
    \draw[play] (29,0) .. controls (33,9) and (37,9) .. (41,0);
    \fill (29,0) circle (1.7); \fill (41,0) circle (1.7);
    \node[token] at (29,-5.5) {}; \node[token] at (41,-5.5) {};
    % a loop uses two tokens
    \draw[rulebox] (49,-10) rectangle (76,13);
    \fill (54,0) circle (1.7);
    \node[token] at (51.8,-5.5) {}; \node[token] at (56.2,-5.5) {};
    \arrowr{(59,0)}
    \draw[play] (71,0) .. controls (60,13) and (82,13) .. (71,0);
    \fill (71,0) circle (1.7);
    % no loop at a dot with one token
    \draw[rulebox] (79,-10) rectangle (104,13);
    \draw[play] (84,0) -- (95,0);
    \draw[play] (95,0) .. controls (84,13) and (106,13) .. (95,0);
    \fill (84,0) circle (1.7); \fill (95,0) circle (1.7);
    \node[token] at (84,-5.5) {}; \node[token] at (95,-5.5) {};
    \nomark{(100.5,9.5)}
    % no crossing
    \draw[rulebox] (107,-10) rectangle (132,13);
    \draw[play] (112,-7) -- (126,3); \draw[play] (112,3) -- (126,-7);
    \fill (112,-7) circle (1.7); \fill (126,3) circle (1.7);
    \fill (112,3) circle (1.7); \fill (126,-7) circle (1.7);
    \nomark{(128.5,9.5)}
    % no passing over a dot: the middle dot keeps both tokens
    \draw[rulebox] (135,-10) rectangle (169,13);
    \draw[play] (140,-1) .. controls (151,9) .. (162,-1);
    \fill (140,-1) circle (1.7); \fill (151,4) circle (1.7); \fill (162,-1) circle (1.7);
    \node[token] at (140,-6.5) {}; \node[token] at (162,-6.5) {};
    \node[token] at (148.8,-1.5) {}; \node[token] at (153.2,-1.5) {};
    \nomark{(165.5,9.5)}
  \end{tikzpicture}}

