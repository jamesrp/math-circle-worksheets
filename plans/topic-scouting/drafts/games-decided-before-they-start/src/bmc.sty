\newcommand{\writelines}[2][\linewidth]{% #2 = number of lines
  \par\begin{tikzpicture}[x=1mm,y=1mm]
    \path (0,-1.5);
    \foreach \i in {1,...,#2} \draw[black!35,line width=0.4pt] (0,-\i*8.5) -- ++(#1-1pt,0);
  \end{tikzpicture}\par}

% ---------- bars ----------
% \chocbar{rows}{cols}{square size in mm}
\newcommand{\chocbar}[3]{%
  \begin{tikzpicture}[x=#3mm,y=#3mm,baseline=(current bounding box.center)]
    \fill[black!10] (0,0) rectangle (#2,#1);
    \draw[step=1,black!65,line width=0.5pt] (0,0) grid (#2,#1);
    \draw[line width=1.1pt] (0,0) rectangle (#2,#1);
  \end{tikzpicture}}

\newcommand{\breakpicture}[1][7]{%
  \begin{tikzpicture}[x=#1mm,y=#1mm]
    \fill[black!10] (0,0) rectangle (5,2);
    \draw[step=1,black!65,line width=0.5pt] (0,0) grid (5,2);
    \draw[line width=1.1pt] (0,0) rectangle (5,2);
    \draw[line width=1.8pt,dash pattern=on 3pt off 2pt] (2,-0.45) -- (2,2.45);
    \draw[-{Stealth[length=3mm]},line width=1.2pt] (5.8,1) -- (7.4,1);
    \begin{scope}[shift={(8.2,0)}]
      \fill[black!10] (0,0) rectangle (2,2);
      \draw[step=1,black!65,line width=0.5pt] (0,0) grid (2,2);
      \draw[line width=1.1pt] (0,0) rectangle (2,2);
    \end{scope}
    \begin{scope}[shift={(10.9,0)}]
      \fill[black!10] (0,0) rectangle (3,2);
      \draw[step=1,black!65,line width=0.5pt] (0,0) grid (3,2);
      \draw[line width=1.1pt] (0,0) rectangle (3,2);
    \end{scope}
  \end{tikzpicture}}

% ---------- dots, tokens, boards ----------
\tikzset{
  mm/.style={x=1mm,y=1mm},
  token/.style={circle,fill=black!22,draw=black!70,line width=0.5pt,minimum size=3.6mm,inner sep=0pt},
  play/.style={line width=0.9pt},
}
\newcommand{\gamedot}[1]{\fill #1 circle (1.7);}
\newcommand{\cross}[2][10]{% #1 half-width in mm, #2 centre
  \path #2 coordinate (crossc);
  \draw[line width=1.3pt] ($(crossc)+(-#1,0)$) -- ($(crossc)+(#1,0)$);
  \draw[line width=1.3pt] ($(crossc)+(0,-#1)$) -- ($(crossc)+(0,#1)$);}

