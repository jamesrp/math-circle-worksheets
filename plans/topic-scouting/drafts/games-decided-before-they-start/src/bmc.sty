    \draw[rulebox] (-7,-10) rectangle (63,20);
    \fill (0,0) circle (1.7); \fill (16,0) circle (1.7);
    \node[token] at (-4.2,-5.5) {}; \node[token] at (0,-5.5) {}; \node[token] at (4.2,-5.5) {};
    \node[token] at (11.8,-5.5) {}; \node[token] at (16,-5.5) {}; \node[token] at (20.2,-5.5) {};
