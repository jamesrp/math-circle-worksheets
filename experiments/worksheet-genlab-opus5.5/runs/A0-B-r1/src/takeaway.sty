% numbered problem marker
\newcounter{prob}
\newcommand{\prob}{\stepcounter{prob}%
  \tikz[baseline=(n.base)]\node[circle,fill=teal,text=white,inner sep=1.5pt,minimum size=1.35em,font=\subheadfont\small](n){\theprob};\ }

% writing lines
\newcommand{\writelines}[1]{%
  \foreach \i in {1,...,#1}{\par\vspace{0.75em}\noindent\textcolor{faint}{\rule{\linewidth}{0.5pt}}}\par}
\newcommand{\blank}[1][2.2cm]{\textcolor{faint}{\rule[-2pt]{#1}{0.6pt}}}

% ---------- TikZ pictures ----------
% a counter: \ctr{(x,y)}{radius}
\newcommand{\ctr}[2]{%
  \fill[counter] #1 circle (#2);
  \draw[counteredge,line width=0.7pt] #1 circle (#2);
  \draw[counteredge!70,line width=0.4pt] #1 circle ({0.62*#2});}
% a crossed-out counter
\newcommand{\ctrx}[2]{%
  \draw[faint,line width=0.7pt,dashed] #1 circle (#2);
  \draw[orange,line width=1.2pt] ($#1+(-#2,-#2)$) -- ($#1+(#2,#2)$);
  \draw[orange,line width=1.2pt] ($#1+(-#2,#2)$) -- ($#1+(#2,-#2)$);}

% a row of n counters starting at (x,y) with a little gap after each 5
% \ctrrow{n}{x}{y}{radius}{step}
\newcommand{\ctrrow}[5]{%
  \ifnum#1>0
  \foreach \k in {1,...,#1}{%
    \pgfmathsetmacro{\xx}{#2+(\k-1)*#5+int((\k-1)/5)*0.45*#5}
    \ctr{(\xx,#3)}{#4}}
  \fi}

% smiley face (the "I can win" picture): \smiley{(x,y)}{radius}
\newcommand{\smiley}[2]{%
  \draw[teal,line width=1.4pt,fill=white] #1 circle (#2);
  \fill[teal] ($#1+(-0.35*#2,0.25*#2)$) circle (0.11*#2);
  \fill[teal] ($#1+(0.35*#2,0.25*#2)$) circle (0.11*#2);
  \draw[teal,line width=1.4pt] ($#1+(-0.5*#2,-0.12*#2)$) .. controls ($#1+(-0.25*#2,-0.6*#2)$) and ($#1+(0.25*#2,-0.6*#2)$) .. ($#1+(0.5*#2,-0.12*#2)$);}

% spider web (the "trap" picture): \trapweb{(x,y)}{radius}
\newcommand{\trapweb}[2]{%
  \begin{scope}[shift={#1}]
  \fill[white] (0,0) circle (#2);
  \foreach \a in {0,45,...,315}{\draw[orange,line width=0.9pt] (0,0) -- (\a:#2);}
  \foreach \f in {0.33,0.66,1.0}{%
    \draw[orange,line width=0.9pt] (0:\f*#2) -- (45:\f*#2) -- (90:\f*#2) -- (135:\f*#2) -- (180:\f*#2)
      -- (225:\f*#2) -- (270:\f*#2) -- (315:\f*#2) -- cycle;}
  \end{scope}}

% a strip of answer boxes numbered from #1 to #2: \numstrip{from}{to}{box width cm}{box height cm}
\newcommand{\numstrip}[4]{%
  \begin{tikzpicture}[x=1cm,y=1cm]
  \foreach \n [count=\c from 0] in {#1,...,#2}{%
    \draw[grid,line width=0.6pt,fill=white] (\c*#3,0) rectangle ++(#3,-#4);
    \node[font=\small\subheadfont,text=teal] at (\c*#3+0.5*#3,0.28) {\n};}
  \end{tikzpicture}}

% upside-down check
\newcommand{\upsidedown}[1]{\tikz[baseline]\node[rotate=180,font=\small\itshape,text=grid,inner sep=0pt]{#1};}
