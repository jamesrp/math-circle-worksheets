}

% \counters{x}{y}{n}{per row}{sep}{radius}: n counters centred at (x,y), rows of at most "per row"
\newcommand{\counters}[6]{%
  \pgfmathtruncatemacro{\cN}{#3-1}%
  \pgfmathtruncatemacro{\cC}{min(#3,#4)}%
  \pgfmathtruncatemacro{\cR}{ceil(#3/#4)}%
  \foreach \ci in {0,...,\cN}{%
    \pgfmathtruncatemacro{\cc}{mod(\ci,#4)}%
    \pgfmathtruncatemacro{\cr}{floor(\ci/#4)}%
    \draw[ctr] ({#1+(\cc-(\cC-1)/2)*#5},{#2-(\cr-(\cR-1)/2)*#5}) circle (#6);
  }%
}

% \numtable{first}{last}{per row}{cell width}{number row height}{blank row height}{gap between blocks}
\newcommand{\numtable}[7]{%
  \begin{tikzpicture}
    \foreach \k in {#1,...,#2}{%
      \pgfmathtruncatemacro{\idx}{\k-#1}%
      \pgfmathtruncatemacro{\col}{mod(\idx,#3)}%
      \pgfmathtruncatemacro{\blk}{floor(\idx/#3)}%
      \pgfmathsetmacro{\xx}{\col*#4}%
      \pgfmathsetmacro{\yy}{-\blk*(#5+#6+#7)}%
      \fill[black!8] (\xx,\yy) rectangle ++(#4,-#5);
      \draw[cell] (\xx,\yy) rectangle ++(#4,-#5);
      \draw[cell] (\xx,\yy-#5) rectangle ++(#4,-#6);
      \node[text height=1.6ex, text depth=0.3ex] at (\xx+#4/2,\yy-#5/2) {\k};
    }
  \end{tikzpicture}%
}
